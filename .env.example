# Anthropic (AI recipes)
ANTHROPIC_API_KEY=

# Firebase (legacy — being migrated to Supabase)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Supabase
# Create a project at https://supabase.com/dashboard, then grab:
#   Settings → API → Project URL        → NEXT_PUBLIC_SUPABASE_URL
#   Settings → API → Project API keys   → anon public → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Settings → API → Project API keys   → service_role → SUPABASE_SERVICE_ROLE_KEY (server-only, treat as secret)
# For CLI automation, also set SUPABASE_ACCESS_TOKEN (personal access token
# from https://supabase.com/dashboard/account/tokens).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
